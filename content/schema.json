{
  "version": 1,
  "_note": "content/*.json 的配置面。两个消费者共用这一份真相：build_content.py 拿它做校验；生成内容的 skill 拿它逐项提问。引擎里加了新字段要同步这里，build_content.py 会在不一致时报错提醒。",

  "canvas": {
    "width": 1080,
    "height": 1920,
    "_note": "画布尺寸固定在 engine/engine.js 与 engine/render.html，不是配置项。九套版式都是按这个尺寸手调的绝对坐标，改尺寸要重排版式。"
  },

  "meta": {
    "slug": {
      "type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$",
      "label": "英文短名",
      "desc": "用于文件命名与配音缓存，小写字母 / 数字 / 短横线"
    },
    "title": {
      "type": "string", "required": true,
      "label": "视频标题",
      "desc": "存档与成片默认文件名用，不出现在画面里"
    },
    "style": {
      "type": "enum", "values": ["warm", "dark", "tech"], "default": "warm",
      "label": "皮肤",
      "desc": "整体配色，对应 styles/<名>.json"
    },
    "brand": {
      "type": "string", "required": true,
      "label": "HUD 品牌胶囊",
      "desc": "顶部胶囊里的字，如「保险小课堂 · 儿童保险」"
    },
    "disclaimer": {
      "type": "string", "required": true,
      "label": "免责声明",
      "desc": "结尾镜底部的小字，合规用"
    },
    "voice": {
      "type": "string", "default": "zh-CN-XiaoxiaoNeural",
      "label": "配音音色",
      "desc": "edge-tts 音色 id，常用值见 voices。改变它会重做全部配音"
    },
    "rate": {
      "type": "string", "pattern": "^[+-][0-9]+%$", "default": "+0%",
      "label": "语速",
      "desc": "如 +8%；改变它会重做全部配音"
    },
    "fps": {
      "type": "int", "min": 10, "max": 120, "default": 30,
      "label": "帧率",
      "desc": "默认 30。24 是下限——本引擎最快的动效是卡片落位抖动（约 4.8Hz），再低会明显发抖"
    },
    "assetBase": {
      "type": "string", "default": "../src/assets/",
      "label": "插画目录",
      "desc": "相对 engine/ 的插画所在目录"
    },
    "pace": {
      "type": "object",
      "label": "节奏",
      "desc": "每镜留白、转场时长与撞击闪光。前三项只改时长不改画面，是最便宜的「利落 / 从容」开关；后两项改画面",
      "fields": {
        "lead":       { "type": "number", "min": 0,    "max": 2, "default": 0.30, "label": "配音前留白", "desc": "秒。徽标、大标题在这段里落位" },
        "tail":       { "type": "number", "min": 0.10, "max": 2, "default": 0.36, "label": "配音后留白", "desc": "秒。除最后一镜外每镜尾部" },
        "lastTail":   { "type": "number", "min": 0.10, "max": 4, "default": 1.20, "label": "末镜后留白", "desc": "秒。给收尾留的时间" },
        "transition": { "type": "number", "min": 0,    "max": 1.5, "default": 0.45, "label": "转场时长", "desc": "秒。相邻两镜的混合窗口宽度，花样（溶解/左右滑/上滑/擦除/横带）按进镜的 tpl 自动选。写 0 = 硬切" },
        "flash":      { "type": "number", "min": 0,    "max": 1.5, "default": 0.11, "label": "撞击闪光", "desc": "秒。每镜主体开始落位时叠一层全屏强调色。写 0 = 关闭，换镜就是干净的硬切" }
      }
    }
  },

  "colors": {
    "accent": ["orange", "coral", "mint", "blue", "red", "yellow", "purple"],
    "themeKeys": [
      "bg", "bg2", "ink", "ink2", "shadow",
      "orange", "coral", "mint", "blue", "red", "white", "yellow", "purple",
      "card", "onAccent", "soft", "dash", "seal", "headFrom", "sheen",
      "coin", "coinEdge", "coinInk", "hudTrack", "hudChip",
      "subBg", "subInk", "subShadow", "lineA", "splitLeft", "splitRight",
      "walletDot", "outroBg1", "outroBg2", "outroBg3", "outroGlow", "glow",
      "vignette", "grain", "gridInk", "scanInk", "fontNum"
    ],
    "_note": "accent 是每镜能选的强调色名；themeKeys 是 content 顶层 theme 与 styles/*.json 里允许出现的键，必须与 engine.js 的 C 对象一致（build_content.py 会核对）"
  },

  "voices": [
    { "id": "zh-CN-XiaoxiaoNeural", "label": "晓晓 · 女声（默认，温和）" },
    { "id": "zh-CN-XiaoyiNeural",   "label": "晓伊 · 女声（更年轻）" },
    { "id": "zh-CN-YunxiNeural",    "label": "云希 · 男声（清朗）" },
    { "id": "zh-CN-YunyangNeural",  "label": "云扬 · 男声（新闻播报感）" },
    { "id": "zh-CN-liaoning-XiaobeiNeural", "label": "晓北 · 东北女声（亲切）" }
  ],

  "assets": {
    "type": "list",
    "item": {
      "type": "object",
      "fields": {
        "name": { "type": "string", "required": true, "pattern": "^[a-z0-9_-]+$" },
        "file": { "type": "string", "required": true }
      }
    },
    "min": 0,
    "_note": "每镜的 asset 字段只能引用这里的 name。name 与 file 都要在，文件要真实存在。可以整份省略（无插画片子），也可以空数组"
  },

  "scenes": {
    "type": "list",
    "min": 1,
    "common": {
      "id": {
        "type": "string", "required": true, "pattern": "^[a-z][a-z0-9_-]*$",
        "label": "镜号",
        "desc": "唯一。配音文件按它命名，如 s1 / s2"
      },
      "tpl": {
        "type": "enum", "required": true,
        "values": ["hook", "step", "chips", "split", "bigNumber", "pitfalls", "coins", "funnel", "outro"],
        "label": "版式",
        "desc": "九选一，决定这镜怎么排"
      },
      "accent": {
        "type": "color", "required": true,
        "label": "强调色",
        "desc": "本镜主色。相邻两镜不要同色"
      },
      "narration": {
        "type": "string", "required": true, "minLen": 6, "maxLen": 60,
        "label": "解说词",
        "desc": "会被转成配音和字幕。12–40 字，口语，不用书面词、不出现分号"
      },
      "energy": {
        "type": "enum", "values": ["high", "low"],
        "label": "节奏强度",
        "desc": "不填按 high。high = 重音镜：进镜有撞击闪光 + 横抖，弹性缓动。low = 过渡镜：不闪不抖，入场曲线也换成最平的，用来给重音镜让出对比。整片都是 high 就等于没有节奏"
      }
    },
    "tpl": {
      "hook": {
        "label": "开场钩子",
        "desc": "大标题 + 插画 + 从下往上飘的推销弹窗雨。只该出现在第 1 镜",
        "fields": {
          "title":  { "type": "string", "required": true, "label": "大标题", "desc": "两行大字，8–12 字" },
          "sub":    { "type": "string", "required": true, "label": "副标题", "desc": "一行，6–10 字" },
          "asset":  { "type": "asset",  "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "popups": {
            "type": "list", "required": true, "min": 4, "max": 14, "label": "弹窗雨",
            "desc": "每项 [文案, 颜色, 横向位置, 速度]。位置 100–980，速度 0.8–1.3 左右，雨点要散布开。**弹窗按数组下标错峰下落（间距 220px），前 4 条起步时正好在大标题那一带**，所以它们的横向位置要贴边放（≤200 或 ≥880），否则会从标题上压过去；第 5 条起从标题下方起步，位置随意",
            "item": { "type": "tuple", "of": ["string", "color", "number", "number"],
                      "labels": ["文案", "颜色", "横向位置", "速度"] }
          }
        }
      },
      "step": {
        "label": "讲一个步骤（突出一个大数字）",
        "desc": "左上序号徽标 → 上部插画 → 中部大数字卡片 → 底部条幅",
        "fields": {
          "badge":  { "type": "badge",  "required": true, "label": "序号徽标" },
          "asset":  { "type": "asset",  "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "card":   {
            "type": "object", "required": true, "label": "大数字卡片",
            "fields": {
              "title": { "type": "string", "required": true, "label": "卡头", "desc": "如「少儿医保」" },
              "sub":   { "type": "string", "required": true, "label": "卡头副标题", "desc": "如「城乡居民基本医疗保险」" },
              "value": { "type": "string", "required": true, "label": "大字", "desc": "如「200-300」" },
              "unit":  { "type": "string", "required": true, "label": "单位", "desc": "如「元 / 年」" },
              "note":  { "type": "string", "required": true, "label": "脚注", "desc": "如「出生即可办理」" }
            }
          },
          "ribbon": { "type": "string", "required": true, "label": "底部条幅", "desc": "一句结论，14–22 字" }
        }
      },
      "chips": {
        "label": "讲一个步骤（突出两条短信息）",
        "desc": "序号徽标 + 中部插画 + 两枚白色胶囊",
        "fields": {
          "badge": { "type": "badge", "required": true, "label": "序号徽标" },
          "asset": { "type": "asset", "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "chips": {
            "type": "list", "required": true, "min": 2, "max": 2, "label": "胶囊",
            "desc": "每项 [文案, 解说进度0-1, 横向中心x, 纵向中心y, 颜色]。两枚的 y 用 1116 / 1268",
            "item": { "type": "tuple", "of": ["string", "fraction", "number", "number", "color"],
                      "labels": ["文案", "出现时机", "横向中心x", "纵向中心y", "颜色"] }
          }
        }
      },
      "split": {
        "label": "讲费用怎么分摊",
        "desc": "序号徽标 + 上部插画 + 左右分割费用条 + 斜纹高亮面板 + 金币入库",
        "fields": {
          "badge": { "type": "badge", "required": true, "label": "序号徽标" },
          "asset": { "type": "asset", "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "bar":   {
            "type": "tuple", "required": true, "of": ["string", "string"], "labels": ["左段", "右段"],
            "label": "费用条两段文案",
            "desc": "[左段, 右段]，各 4–6 字，如 [「医保报销」,「自付部分」]"
          },
          "panel": {
            "type": "object", "required": true, "label": "高亮面板",
            "fields": {
              "title": { "type": "string", "required": true, "label": "面板标题" },
              "value": { "type": "string", "required": true, "label": "面板数值", "desc": "如「保额 200 万+」" }
            }
          }
        }
      },
      "bigNumber": {
        "label": "突出一个核心保额/数字",
        "desc": "序号徽标 + 顶部保额卡（数字滚动）+ 右侧插画 + 左侧三枚标签 + 左下警示徽标",
        "fields": {
          "badge": { "type": "badge", "required": true, "label": "序号徽标" },
          "asset": { "type": "asset", "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "value": {
            "type": "object", "required": true, "label": "保额卡",
            "fields": {
              "label":     { "type": "string", "required": true, "label": "小标题", "desc": "如「保额」" },
              "number":    { "type": "number", "required": true, "min": 1, "label": "数字", "desc": "会滚动增长；纯数字，不带单位" },
              "unit":      { "type": "string", "required": true, "label": "单位", "desc": "如「万」" },
              "note":      { "type": "string", "required": true, "label": "脚注" },
              "color":     { "type": "color",  "required": true, "label": "数字颜色" },
              "noteColor": { "type": "color",  "required": true, "label": "脚注颜色" }
            }
          },
          "tags": {
            "type": "list", "required": true, "min": 3, "max": 3, "label": "侧标签",
            "desc": "每项 [文案, 解说进度0-1, y]。y 用 780 / 895 / 1010",
            "item": { "type": "tuple", "of": ["string", "fraction", "number"],
                      "labels": ["文案", "出现时机", "纵向中心y"] }
          },
          "warn": { "type": "string", "required": false, "label": "警示徽标", "desc": "选填，2–6 字，**默认不填**——多数片子不需要它，不填就在左下角什么都不画。填了就出一枚红框徽标、文字左边站一个 ✗，所以要填**要否定的做法**，不是提示：填「返还型」读作「✗ 返还型」。不要它就把整个 warn 键删掉，别写空字符串" }
        }
      },
      "pitfalls": {
        "label": "三个坑（固定 3 条）",
        "desc": "大标题 + 三张红叉卡片，逐张横向展开并带抖动。**不放插画**",
        "fields": {
          "title": { "type": "string", "required": true, "label": "大标题", "desc": "如「三个坑，别踩」" },
          "items": {
            "type": "list", "required": true, "min": 3, "max": 3, "label": "三条坑",
            "desc": "每项 [文案, 解说进度0-1]，文案 8–14 字，要具体反例",
            "item": { "type": "tuple", "of": ["string", "fraction"],
                      "labels": ["文案", "出现时机"] }
          }
        }
      },
      "coins": {
        "label": "教育金 / 储蓄类",
        "desc": "序号徽标 + 中部插画 + 三枚金币下落 + 右上角提示胶囊",
        "fields": {
          "badge": { "type": "badge", "required": true, "label": "序号徽标" },
          "asset": { "type": "asset", "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "note":  { "type": "string", "required": true, "label": "提示胶囊", "desc": "如「保障做齐，再谈理财」" }
        }
      },
      "funnel": {
        "label": "结论排序（固定 5 级）",
        "desc": "标题 + 五根高低不等的流程柱（末根虚线框）+ 顶部箭头连接线 + 底部链条文案。**不放插画**",
        "fields": {
          "title": { "type": "string", "required": true, "label": "大标题" },
          "sub":   { "type": "string", "required": true, "label": "副标题" },
          "steps": {
            "type": "list", "required": true, "min": 5, "max": 5, "label": "五级流程",
            "desc": "每项 [名, 颜色, 柱高]。柱高 130–400 递增；第 5 根固定画成虚线框",
            "item": { "type": "tuple", "of": ["string", "color", "number"],
                      "labels": ["名称", "颜色", "柱高"] }
          },
          "chain": { "type": "string", "required": true, "label": "底部链条", "desc": "如「医保 → 意外 → 医疗 → 重疾 → 教育金」" }
        }
      },
      "outro": {
        "label": "结尾 + 关注引导",
        "desc": "独立渐变底 + 主副标题 + 插画 + 关注胶囊 + 免责声明",
        "fields": {
          "title": { "type": "string", "required": true, "label": "主标题", "desc": "把结论压成一句口诀" },
          "sub":   { "type": "string", "required": true, "label": "副标题" },
          "asset": { "type": "asset", "required": false, "label": "插画", "desc": "留空 = 无插画几何版式。要么填 assets 里的合法素材名，要么把整个 asset 键删掉（空字符串 \"\" 会报错）" },
          "cta":   { "type": "string", "required": true, "label": "关注胶囊", "desc": "一句大白话 + 一个利益点" }
        }
      }
    }
  }
}
